{
  "entities": {
    "Item": {
      "title": "Item",
      "description": "A çeyiz item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "isBought": { "type": "boolean" },
        "notes": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "name", "category", "price", "isBought"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences and settings",
      "type": "object",
      "properties": {
        "budget": { "type": "number" },
        "categories": { "type": "array", "items": { "type": "string" } },
        "theme": { "type": "string", "enum": ["light", "dark"] }
      }
    },
    "Backup": {
      "title": "Backup",
      "description": "A backup of the user's data",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "number" },
        "items": { "type": "array", "items": { "$ref": "Item" } },
        "budget": { "type": "number" },
        "categories": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "timestamp", "items", "budget", "categories"]
    }
  },
  "firestore": {
    "/users/{userId}/items/{itemId}": {
      "schema": "Item",
      "description": "User's çeyiz items"
    },
    "/users/{userId}/settings/current": {
      "schema": "UserSettings",
      "description": "User's current settings"
    },
    "/users/{userId}/backups/{backupId}": {
      "schema": "Backup",
      "description": "User's data backups"
    }
  }
}
