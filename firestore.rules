rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users/{userId}/items
    // Fields:
    //   - id: string (required)
    //   - name: string (required, 1-100 chars)
    //   - category: string (required)
    //   - price: number (required, >= 0)
    //   - isBought: bool (required)
    //   - notes: string (optional)
    //   - image: string (optional, URL)
    //   - link: string (optional, URL)
    //   - createdAt: number (required)
    //
    // Collection: users/{userId}/settings
    // Fields:
    //   - budget: number (required, >= 0)
    //   - categories: list of strings (required)
    //   - theme: string (required, 'light' or 'dark')
    //
    // Collection: users/{userId}/backups
    // Fields:
    //   - id: string (required)
    //   - timestamp: number (required)
    //   - items: list of Item objects (required)
    //   - budget: number (required)
    //   - categories: list of strings (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUrl(url) {
      return url is string && (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidItem(data) {
      return hasRequiredFields(['id', 'name', 'category', 'price', 'isBought']) &&
             hasOnlyAllowedFields(['id', 'name', 'category', 'price', 'isBought', 'notes', 'image', 'link', 'createdAt']) &&
             data.id is string && data.id.size() > 0 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.category is string &&
             data.price is number && data.price >= 0 &&
             data.isBought is bool &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('image' in data) || isValidUrl(data.image)) &&
             (!('link' in data) || isValidUrl(data.link)) &&
             (!('createdAt' in data) || data.createdAt is number);
    }

    function isValidSettings(data) {
      return hasRequiredFields(['budget', 'categories', 'theme']) &&
             hasOnlyAllowedFields(['budget', 'categories', 'theme']) &&
             data.budget is number && data.budget >= 0 &&
             data.categories is list &&
             data.theme in ['light', 'dark'];
    }

    function isValidBackup(data) {
      return hasRequiredFields(['id', 'timestamp', 'items', 'budget', 'categories']) &&
             data.id is string &&
             data.timestamp is number &&
             data.items is list &&
             data.budget is number &&
             data.categories is list;
    }

    // ===============================================================
    // Match Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId);
      
      match /items/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidItem(request.resource.data);
        allow delete: if isOwner(userId);
      }
      
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSettings(request.resource.data);
        allow delete: if isOwner(userId);
      }

      match /backups/{backupId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBackup(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
